{
  "name": "bloodline-legacy-production",
  "main": "worker.mjs",
  "compatibility_date": "2026-09-07",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./out/production",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/",
      "/index.html"
    ],
    "not_found_handling": "none"
  },
  "vars": {
    "APP_ENV": "production"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "WORLDS",
        "class_name": "GameWorld"
      }
    ]
  },
  "migrations": [
    {
      "tag": "game-world-v1",
      "new_sqlite_classes": [
        "GameWorld"
      ]
    }
  ]
}
